{
  "$schema": "./schemas/source-boundaries.schema.json",
  "schemaVersion": 1,
  "sourceRoot": "src/prctr",
  "layers": ["base", "platform", "editor", "workbench", "code"],
  "environments": {
    "common": ["common"],
    "worker": ["common", "worker"],
    "browser": ["common", "browser"],
    "node": ["common", "node"],
    "electron-browser": ["common", "browser", "electron-browser"],
    "electron-utility": ["common", "node", "electron-utility"],
    "electron-main": ["common", "node", "electron-utility", "electron-main"]
  },
  "environmentOverrides": {
    "src/prctr/workbench/workbench.common.main.ts": "browser"
  },
  "testSegments": ["test"],
  "productionDynamicImportAllowlist": [],
  "cssImportantOverrides": [
    {
      "path": "src/prctr/workbench/contrib/terminal/browser/remoteTerminalPanel.css",
      "selector": ".prctr-terminal .xterm-dim",
      "property": "opacity",
      "rationale": "Preserve xterm dim rendering by preventing its generated foreground opacity from dimming cell backgrounds."
    }
  ]
}
