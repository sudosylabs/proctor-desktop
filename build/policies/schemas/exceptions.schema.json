{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exceptions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "exceptions"],
  "properties": {
    "$schema": { "const": "./schemas/exceptions.schema.json" },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "target", "owner", "rationale", "evidence", "removalCondition"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "check": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
          "target": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "removalCondition": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
