{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-boundaries.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "sourceRoot",
    "layers",
    "environments",
    "environmentOverrides",
    "defaultEnvironments",
    "contributionRoot",
    "testSegments",
    "productionDynamicImportAllowlist",
    "cssImportantOverrides"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/source-boundaries.schema.json"
    },
    "sourceRoot": {
      "$ref": "#/$defs/path"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "environmentOverrides": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/name"
      }
    },
    "defaultEnvironments": {
      "description": "The environment of a source path under one of these folders when no path segment names one.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/name"
      }
    },
    "contributionRoot": {
      "description": "The folder of Proctor-authored feature contributions, one folder per feature.",
      "$ref": "#/$defs/path"
    },
    "testSegments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "productionDynamicImportAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "cssImportantOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "selector", "property", "rationale"],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "rationale": {
            "type": "string",
            "minLength": 24
          }
        }
      }
    },
    "staticAssetImports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["importer", "resource", "kind", "rationale"],
        "properties": {
          "importer": {
            "$ref": "#/$defs/path"
          },
          "resource": {
            "$ref": "#/$defs/path"
          },
          "kind": {
            "enum": ["data", "font"]
          },
          "rationale": {
            "type": "string",
            "minLength": 24
          }
        }
      }
    },
    "rawColorStylesheets": {
      "description": "Ratchet: Proctor stylesheets that still hold raw colours; each leaves the list once it uses tokens.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^src/prctr/.+\\.css$"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
