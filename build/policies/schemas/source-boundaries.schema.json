{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-boundaries.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sourceRoot", "layers", "environments", "testSegments", "productionDynamicImportAllowlist"],
  "properties": {
    "$schema": { "const": "./schemas/source-boundaries.schema.json" },
    "schemaVersion": { "const": 1 },
    "sourceRoot": { "$ref": "#/$defs/path" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/name" }
      }
    },
    "testSegments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "productionDynamicImportAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
  }
}
