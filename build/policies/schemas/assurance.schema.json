{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assurance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "invariantSource", "controls"],
  "properties": {
    "$schema": { "const": "./schemas/assurance.schema.json" },
    "schemaVersion": { "const": 1 },
    "invariantSource": { "$ref": "#/$defs/path" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "owner", "invariants"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["source", "generation", "test", "package", "review"] },
        "status": { "enum": ["active", "deferred"] },
        "owner": { "type": "string", "minLength": 1 },
        "invariants": { "$ref": "#/$defs/invariants" },
        "implementation": { "$ref": "#/$defs/id" },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "activation": { "enum": ["source-present", "workspace-source-present", "browser-source-present", "execution-source-present", "code-layer-present", "css-present", "settings-registry-present", "native-package-present", "packaged-target-present"] },
        "futureKind": { "enum": ["source", "generation", "test", "package", "review"] },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
          "then": { "anyOf": [{ "required": ["implementation"] }, { "required": ["evidence"] }] }
        },
        {
          "if": { "properties": { "status": { "const": "deferred" } }, "required": ["status"] },
          "then": { "required": ["activation", "futureKind", "rationale"] }
        }
      ]
    }
  }
}
