{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependencies.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "allowedLicenseExpressions", "dependencies"],
  "properties": {
    "$schema": { "const": "./schemas/dependencies.schema.json" },
    "schemaVersion": { "const": 1 },
    "allowedLicenseExpressions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "kind", "purpose", "owner", "source", "license", "lifecycleScripts"],
      "properties": {
        "ecosystem": { "enum": ["npm", "cargo"] },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "kind": { "enum": ["development", "production"] },
        "purpose": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "lifecycleScripts": { "enum": ["none", "blocked", "allowed"] },
        "declarations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/cargoDeclaration" }
        },
        "processes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "networkBehavior": { "type": "string", "minLength": 1 },
        "nativeBehavior": { "type": "string", "minLength": 1 },
        "transitiveRisk": { "type": "string", "minLength": 1 },
        "bundleTreatment": { "enum": ["bundled", "external-native", "external-platform"] },
        "localAlternative": { "type": "string", "minLength": 1 },
        "updateOwner": { "type": "string", "minLength": 1 },
        "removalOwner": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "production" } }, "required": ["kind"] },
          "then": { "required": ["processes", "networkBehavior", "nativeBehavior", "transitiveRisk", "bundleTreatment", "localAlternative", "updateOwner", "removalOwner"] }
        },
        {
          "if": { "properties": { "ecosystem": { "const": "cargo" } }, "required": ["ecosystem"] },
          "then": { "required": ["declarations"] }
        }
      ]
    },
    "cargoDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "alias", "kind", "features", "defaultFeatures", "optional", "targetScope"],
      "properties": {
        "manifest": { "type": "string", "pattern": "^native/(?:[A-Za-z0-9._-]+/)+Cargo\\.toml$" },
        "alias": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "kind": { "enum": ["development", "production"] },
        "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "defaultFeatures": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "targetScope": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    }
  }
}
