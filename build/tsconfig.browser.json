{
  "extends": "./tsconfig.base-common.json",
  "compilerOptions": {
    "customConditions": ["browser"],
    "lib": ["DOM", "DOM.Iterable", "ES2024", "ESNext.Disposable", "WebWorker.ImportScripts"],
    "types": ["trusted-types", "@webgpu/types", "wicg-file-system-access"]
  },
  "exclude": ["../src/prctr/editor/browser/worker/**"],
  "include": [
    "../src/prctr/base/common/thenable.d.ts",
    "../src/prctr/base/common/vscodeBaseCommonGlobals.d.ts",
    "../src/prctr/**/browser/**/*.ts",
    "../test/browser/**/*.ts"
  ]
}
