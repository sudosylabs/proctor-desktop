      "verificationRefs": ["browser-theme-projection"]
    }
  ],
  "verification": [
    {
      "id": "theme-resolution-tests",
      "kind": "test",
      "path": "test/platform/theme/common/colorThemeEngine.test.ts",
      "obligation": "Color defaults, derived transforms, global/scoped/wildcard/default overrides, invalid input, include ordering/cycles, packaged identity, removal and independent role projection."
    },
    {
      "id": "offline-provenance",
      "kind": "check",
      "path": "build/checks/provenance.ts",
      "obligation": "Exact local source ownership, digest, license and source marker parity."
    },
    {
      "id": "browser-theme-projection",
      "kind": "test",
      "path": "test/browser/workbenchKernelTests.ts",
      "obligation": "Live CSS variables and late packaged participants, override removal, failed selection preservation, settings preview/cancel and stylesheet disposal."
    },
    {
      "id": "native-theme-projection",
      "kind": "test",
      "path": "test/electron/windowSkeletonMain.ts",
      "obligation": "Authenticated settings startup/preview/cancel/commit, bound IPC, native title bar colors, theme source and modal dimming."
    }
  ]
