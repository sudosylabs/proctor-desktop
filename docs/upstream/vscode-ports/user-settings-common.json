      ]
    },
    {
      "id": "configuration-storage-adapter",
      "summary": "ConfigurationService and ConfigurationEditing consume a resource adapter. SettingsDraft supplies the working copy, owns queued edit lifetimes and rejects concurrent source replacement. Explicit Save retains the existing privileged revision/idempotency commit owner. URI access is closed to the configured document and logging discards settings data. This does not transplant the Monaco or graphical Settings editor.",
      "localPaths": [
