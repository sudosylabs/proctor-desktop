{
  "name": "proctor-desktop",
  "productName": "Proctor",
  "appId": "fr.sudosy.proctor",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "audit:upstream": "node build/checks/upstreamAudit.ts",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run check:types && npm run lint && npm run format:check && node build/checks/main.ts && npm run check:licenses && npm run test:unit",
    "check:licenses": "node build/checks/dependencyLicenses.ts",
    "check:types": "node scripts/typecheck.ts",
    "check:assurance": "node build/checks/main.ts --check assurance.coverage",
    "check:dependencies": "node build/checks/main.ts --check dependencies.admission",
    "check:docs": "node build/checks/main.ts --check repository.documentation --check repository.hygiene --check ci.actions-pinned",
    "check:generated": "node build/checks/main.ts --check generated.parity",
    "check:layers": "node build/checks/main.ts --check source.graph",
    "check:provenance": "node build/checks/main.ts --check upstream.provenance",
    "check:source": "node build/checks/main.ts --check source.graph --check source.compositions --check source.css",
    "build:browser-harness": "node build/buildBrowserHarness.ts",
    "build:base-common-tests": "node build/buildBaseCommonTests.ts",
    "build:platform-foundation-tests": "node build/buildPlatformFoundationTests.ts",
    "build:editor-core-tests": "node build/buildEditorCoreTests.ts",
    "build:window-skeleton": "node build/buildWindowSkeleton.ts",
    "preview:launch": "node scripts/previewLaunch.ts",
    "preview:notifications": "node scripts/previewNotifications.ts",
    "generate": "node build/generators/main.ts --write",
    "inspect": "node build/checks/main.ts --inspect",
    "test": "npm run test:unit",
    "test:base": "node scripts/test.ts base",
    "test:platform-foundation": "node scripts/test.ts platform",
    "test:checks": "node scripts/test.ts checks",
    "test:browser": "node scripts/test.ts browser",
    "test:electron": "node scripts/test.ts electron",
    "test:editor": "node scripts/test.ts editor",
    "test:native": "node build/testNative.ts",
    "test:native-agent": "node scripts/test.ts native-agent",
    "test:window-skeleton": "node scripts/test.ts window-skeleton",
    "test:unit": "node scripts/test.ts unit",
    "check:all": "npm run check && npm run test:electron && npm run test:native",
    "doctor": "node scripts/doctor.ts",
    "tasks": "node build/tasks.ts --list",
    "setup": "node scripts/setup.ts",
    "lint": "node --max-old-space-size=4096 scripts/lint.ts",
    "lint:fix": "node --max-old-space-size=4096 scripts/lint.ts --fix",
    "format:check": "node scripts/format.ts",
    "format": "node scripts/format.ts --write",
    "check:staged": "node scripts/staged.ts",
    "hooks:enable": "node scripts/hooks.ts --enable",
    "hooks:disable": "node scripts/hooks.ts --disable",
    "dev": "node scripts/developDesktop.ts",
    "test:desktop-identity": "node scripts/test.ts desktop-identity",
    "api:sync": "node scripts/syncServerApi.ts"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@tanstack/query-core": "5.102.8",
    "@vscode/codicons": "0.0.46-39",
    "@vscode/diff": "0.0.2-7",
    "@vscode/l10n": "0.0.18",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "44.11.3",
    "highlight.js": "11.11.1",
    "lodash.throttle": "4.1.1",
    "markdown-it": "14.3.3",
    "morphdom": "2.7.8",
    "path-browserify": "1.0.1",
    "pdfjs-dist": "6.3.289",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-markdown-languageservice": "0.5.0",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.3.2",
    "vscode-uri": "3.1.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron/asar": "4.3.2",
    "@electron/fuses": "2.1.3",
    "@types/js-yaml": "4.0.9",
    "@types/lodash.throttle": "4.1.9",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.13.3",
    "@types/sinon": "10.0.2",
    "@types/trusted-types": "2.0.7",
    "@types/wicg-file-system-access": "2023.10.7",
    "@types/ws": "8.18.1",
    "@webgpu/types": "0.1.74",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "json-schema-to-ts": "3.1.1",
    "mdast-util-from-markdown": "2.1.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "postcss-selector-parser": "7.2.1",
    "prettier": "3.10.1",
    "resedit": "3.1.1",
    "sinon": "12.0.1",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "sinon": {
      "@sinonjs/commons": "1.8.3",
      "type-detect": "4.0.8",
      "@sinonjs/fake-timers": "7.1.2",
      "@sinonjs/samsam": "6.0.2",
      "lodash.get": "4.4.2",
      "diff": "5.2.2",
      "nise": "5.1.0",
      "@sinonjs/text-encoding": "0.7.1",
      "just-extend": "4.2.1",
      "path-to-regexp": "1.9.0",
      "isarray": "0.0.1",
      "supports-color": "7.2.0",
      "has-flag": "4.0.0"
    },
    "@types/sinon": {
      "@sinonjs/fake-timers": "7.1.2",
      "@sinonjs/commons": "1.8.3",
      "type-detect": "4.0.8"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "vscode-markdown-languageservice": {
      "vscode-uri": "3.0.7"
    }
  },
  "optionalDependencies": {
    "@vnilink/elg": "0.1.0-rc.1"
  }
}
