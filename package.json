{
  "name": "proctor-desktop",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "audit:upstream": "node build/checks/upstreamAudit.ts",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run check:types && node build/checks/main.ts && npm run check:licenses && npm run test:checks && npm run test:base && npm run test:security-utility && npm run test:native",
    "check:licenses": "node build/checks/dependencyLicenses.ts",
    "check:types": "tsc --project build/tsconfig.json --noEmit && tsc --project build/tsconfig.common.json --noEmit && tsc --project build/tsconfig.base-common.json --noEmit && tsc --project build/tsconfig.base-common-test.json --noEmit && tsc --project build/tsconfig.common-test.json --noEmit && tsc --project build/tsconfig.browser.json --noEmit && tsc --project build/tsconfig.electron-main.json --noEmit && tsc --project build/tsconfig.electron-utility.json --noEmit && tsc --project build/tsconfig.electron-test.json --noEmit",
    "check:assurance": "node build/checks/main.ts --check assurance.coverage",
    "check:dependencies": "node build/checks/main.ts --check dependencies.admission",
    "check:docs": "node build/checks/main.ts --check repository.documentation --check repository.hygiene --check ci.actions-pinned",
    "check:generated": "node build/checks/main.ts --check generated.parity",
    "check:layers": "node build/checks/main.ts --check source.graph",
    "check:provenance": "node build/checks/main.ts --check upstream.provenance",
    "check:source": "node build/checks/main.ts --check source.graph --check source.compositions --check source.css",
    "build:security-utility": "node build/buildSecurityUtility.ts",
    "build:browser-harness": "node build/buildBrowserHarness.ts",
    "build:base-common-tests": "node build/buildBaseCommonTests.ts",
    "generate": "node build/generators/main.ts --write",
    "inspect": "node build/checks/main.ts --inspect",
    "test": "npm run test:checks",
    "test:base": "npm run build:base-common-tests && node --test .build/base-common-tests/**/*.test.js",
    "test:checks": "node --test test/checks/*.test.ts",
    "test:browser": "npm run build:browser-harness && node --test test/electron/browserHarness.real.test.ts",
    "test:electron": "npm run build:security-utility && node --test test/electron/*.real.test.ts",
    "test:native": "node build/testNative.ts",
    "test:security-utility": "node build/testSecurityUtility.ts",
    "test:unit": "npm run test:checks && npm run test:security-utility"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "electron": "44.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "mdast-util-from-markdown": "2.0.3",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.5",
    "smol-toml": "1.8.0",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}
