{
  "$defs": {
    "AgentToHelper": {
      "description": "What the agent sends.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The first message, exactly once.",
          "properties": {
            "kind": {
              "const": "hello",
              "type": "string"
            },
            "protocol_digest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "kind",
            "protocol_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Start or change what the helper reports. Each newly enabled stream begins with a snapshot.",
          "properties": {
            "kind": {
              "const": "subscribe",
              "type": "string"
            },
            "processes": {
              "type": "boolean"
            },
            "sessions": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "processes",
            "sessions"
          ],
          "type": "object"
        }
      ]
    },
    "CodeText": {
      "pattern": "^[^\\u0000-\\u001f\\u007f]{1,256}$",
      "type": "string"
    },
    "Count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "HelperIdentity": {
      "description": "A process's code identity. Paths and process names are never identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Still being verified; a `process_identified` follows.",
          "properties": {
            "kind": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A macOS code signature.",
          "properties": {
            "apple": {
              "description": "The signature satisfies `anchor apple`.",
              "type": "boolean"
            },
            "kind": {
              "const": "mac_os",
              "type": "string"
            },
            "signing_identifier": {
              "$ref": "#/$defs/CodeText"
            },
            "team_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CodeText"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "signing_identifier",
            "apple"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A Windows Authenticode or catalog signer and the version resource's original file name.",
          "properties": {
            "kind": {
              "const": "windows",
              "type": "string"
            },
            "original_file_name": {
              "$ref": "#/$defs/CodeText"
            },
            "publisher": {
              "$ref": "#/$defs/CodeText"
            }
          },
          "required": [
            "kind",
            "publisher",
            "original_file_name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The code has no valid signature.",
          "properties": {
            "kind": {
              "const": "unsigned",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The identity could not be read.",
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "HelperLoss": {
      "oneOf": [
        {
          "const": "events_dropped",
          "description": "The OS event stream dropped events (ETW buffers, Endpoint Security queue).",
          "type": "string"
        },
        {
          "const": "queue_overflow",
          "description": "The helper's queue to this agent overflowed.",
          "type": "string"
        },
        {
          "const": "source_restarted",
          "description": "The OS event source stopped and was restarted.",
          "type": "string"
        }
      ]
    },
    "HelperProcess": {
      "additionalProperties": false,
      "description": "One process. `instance` is unique for the process's lifetime (derived from its ID and start\ntime); process IDs alone are reused.",
      "properties": {
        "identity": {
          "$ref": "#/$defs/HelperIdentity"
        },
        "instance": {
          "$ref": "#/$defs/Count"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ],
          "description": "The parent's `instance`, when the parent is still known."
        },
        "pid": {
          "$ref": "#/$defs/Count"
        },
        "scope": {
          "$ref": "#/$defs/ProcessScope"
        }
      },
      "required": [
        "instance",
        "pid",
        "scope",
        "identity"
      ],
      "type": "object"
    },
    "HelperRefusal": {
      "oneOf": [
        {
          "const": "protocol_mismatch",
          "description": "The agent's protocol digest differs from the helper's.",
          "type": "string"
        },
        {
          "const": "unauthorized_peer",
          "description": "The connecting process is not this release's agent.",
          "type": "string"
        },
        {
          "const": "invalid_message",
          "description": "A message arrived out of order or was invalid.",
          "type": "string"
        }
      ]
    },
    "HelperSession": {
      "additionalProperties": false,
      "properties": {
        "has_user": {
          "description": "A person is signed in to this session.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/Count"
        },
        "locked": {
          "description": "`None` when the OS does not report the lock state of this session.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "remote": {
          "description": "Viewed or controlled remotely: a remote-desktop protocol session on Windows, or screen\nsharing attached on macOS.",
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        }
      },
      "required": [
        "id",
        "state",
        "has_user",
        "remote"
      ],
      "type": "object"
    },
    "HelperToAgent": {
      "description": "What the helper sends.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The handshake succeeded.",
          "properties": {
            "helper_version": {
              "$ref": "#/$defs/CodeText"
            },
            "kind": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "helper_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The helper will not serve this connection; it closes it after this message.",
          "properties": {
            "code": {
              "$ref": "#/$defs/HelperRefusal"
            },
            "kind": {
              "const": "refused",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Every process the agent may see, observed after the event stream started, so no process\nfalls between the snapshot and the events that follow it.",
          "properties": {
            "kind": {
              "const": "process_snapshot",
              "type": "string"
            },
            "processes": {
              "items": {
                "$ref": "#/$defs/HelperProcess"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "processes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "process_started",
              "type": "string"
            },
            "process": {
              "$ref": "#/$defs/HelperProcess"
            }
          },
          "required": [
            "kind",
            "process"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A process reported with a `pending` identity has been verified.",
          "properties": {
            "identity": {
              "$ref": "#/$defs/HelperIdentity"
            },
            "instance": {
              "$ref": "#/$defs/Count"
            },
            "kind": {
              "const": "process_identified",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "instance",
            "identity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "instance": {
              "$ref": "#/$defs/Count"
            },
            "kind": {
              "const": "process_exited",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "instance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The complete current session state, sent first and on every change.",
          "properties": {
            "console": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Count"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The session attached to the physical console, when one is."
            },
            "kind": {
              "const": "sessions",
              "type": "string"
            },
            "own": {
              "$ref": "#/$defs/Count",
              "description": "The agent's own session."
            },
            "sessions": {
              "items": {
                "$ref": "#/$defs/HelperSession"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "own",
            "sessions"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Events were lost: the helper follows with fresh snapshots of the affected streams.",
          "properties": {
            "kind": {
              "const": "lost",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/HelperLoss"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Sent every second while subscribed, so a stalled helper is detected.",
          "properties": {
            "kind": {
              "const": "heartbeat",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ProcessScope": {
      "description": "Where a process runs, relative to the connected agent. Processes in another user's session\nare never reported.",
      "oneOf": [
        {
          "const": "candidate_session",
          "description": "The agent's own interactive session.",
          "type": "string"
        },
        {
          "const": "system",
          "description": "A system or service process (Windows session 0 or a service account; macOS root or a\nsystem account outside any user session).",
          "type": "string"
        }
      ]
    },
    "SessionState": {
      "oneOf": [
        {
          "const": "active",
          "description": "Attached to a display and accepting input.",
          "type": "string"
        },
        {
          "const": "disconnected",
          "description": "Signed in but not attached to any display.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Any other state (listening, idle, being reset): no person is using it.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "prctr-helper-protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/AgentToHelper"
    },
    {
      "$ref": "#/$defs/HelperToAgent"
    }
  ],
  "title": "Proctor native helper protocol"
}
