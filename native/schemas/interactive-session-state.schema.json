{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctor.invalid/native/interactive-session-state.schema.json",
  "title": "Proctor native interactive-session observation protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": { "schema_version": { "const": 1 } },
  "$defs": {
    "InteractiveSessionCoverage": {
      "type": "string",
      "enum": ["full_lifecycle", "snapshot_only", "unavailable"]
    },
    "InteractiveSessionCertainty": { "type": "string", "enum": ["complete", "partial", "unknown"] },
    "InteractiveConsoleOwnership": {
      "type": "string",
      "enum": ["candidate", "other_human", "none", "unknown"]
    },
    "InteractiveLockState": { "type": "string", "enum": ["unlocked", "locked", "unknown"] },
    "InteractiveRemoteAttachment": { "type": "string", "enum": ["absent", "present", "unknown"] },
    "InteractiveSessionState": {
      "type": "object",
      "x-proctor-rules": ["coherent_interactive_session_state"],
      "additionalProperties": false,
      "required": [
        "coverage",
        "certainty",
        "console_ownership",
        "lock_state",
        "remote_attachment",
        "other_human_session_count"
      ],
      "properties": {
        "coverage": { "$ref": "#/$defs/InteractiveSessionCoverage" },
        "certainty": { "$ref": "#/$defs/InteractiveSessionCertainty" },
        "console_ownership": { "$ref": "#/$defs/InteractiveConsoleOwnership" },
        "lock_state": { "$ref": "#/$defs/InteractiveLockState" },
        "remote_attachment": { "$ref": "#/$defs/InteractiveRemoteAttachment" },
        "other_human_session_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "x-rust-type": "u8"
        }
      }
    },
    "InteractiveSessionEventKind": { "type": "string", "enum": ["changed", "reconciled"] },
    "InteractiveSessionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state"],
      "properties": {
        "kind": { "$ref": "#/$defs/InteractiveSessionEventKind" },
        "state": { "$ref": "#/$defs/InteractiveSessionState" }
      }
    },
    "InteractiveSessionSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_instance_id",
        "source_version",
        "adapter_version",
        "schema_version",
        "platform",
        "permission",
        "health",
        "sequence",
        "observed_at",
        "state"
      ],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "platform": { "$ref": "native-observation.schema.json#/$defs/PlatformFamily" },
        "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "state": { "$ref": "#/$defs/InteractiveSessionState" }
      }
    },
    "InteractiveSessionObservation": {
      "type": "object",
      "x-proctor-rules": ["gap_ends_immediately_before_sequence"],
      "additionalProperties": false,
      "required": ["source_instance_id", "sequence", "observed_at", "event"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "gap": { "$ref": "native-observation.schema.json#/$defs/SequenceGap" },
        "event": { "$ref": "#/$defs/InteractiveSessionEvent" }
      }
    },
    "InteractiveSessionDrain": {
      "type": "object",
      "x-proctor-rules": ["coherent_source_batch"],
      "additionalProperties": false,
      "required": ["source_instance_id", "health", "observations", "resets"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "observations": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/InteractiveSessionObservation" }
        },
        "resets": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "native-observation.schema.json#/$defs/SourceReset" }
        },
        "terminal_error": { "$ref": "native-observation.schema.json#/$defs/SourceFailureCode" }
      }
    }
  }
}
