{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctor.invalid/native/network-configuration-state.schema.json",
  "title": "Proctor native network-configuration observation protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": { "schema_version": { "const": 1 } },
  "$defs": {
    "NetworkConfigurationCoverage": {
      "type": "string",
      "enum": ["full_configuration", "partial_configuration", "unavailable"]
    },
    "NetworkConfigurationCertainty": {
      "type": "string",
      "enum": ["complete", "partial", "unknown"]
    },
    "NetworkActivityState": { "type": "string", "enum": ["inactive", "active", "unknown"] },
    "NetworkTunnelClass": {
      "type": "string",
      "enum": [
        "managed_vpn",
        "point_to_point",
        "packet_tunnel",
        "virtual_ethernet",
        "other",
        "unknown"
      ]
    },
    "NetworkTunnelInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_instance_id", "class"],
      "properties": {
        "interface_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "class": { "$ref": "#/$defs/NetworkTunnelClass" }
      }
    },
    "NetworkConfigurationState": {
      "type": "object",
      "x-proctor-rules": [
        "coherent_network_configuration_state",
        "unique_network_tunnel_interface_ids"
      ],
      "additionalProperties": false,
      "required": [
        "coverage",
        "certainty",
        "system_proxy",
        "managed_vpn",
        "tunnel_interfaces",
        "route_generation"
      ],
      "properties": {
        "coverage": { "$ref": "#/$defs/NetworkConfigurationCoverage" },
        "certainty": { "$ref": "#/$defs/NetworkConfigurationCertainty" },
        "system_proxy": { "$ref": "#/$defs/NetworkActivityState" },
        "managed_vpn": { "$ref": "#/$defs/NetworkActivityState" },
        "tunnel_interfaces": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/NetworkTunnelInterface" }
        },
        "route_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        }
      }
    },
    "NetworkConfigurationEventKind": { "type": "string", "enum": ["changed", "reconciled"] },
    "NetworkConfigurationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state"],
      "properties": {
        "kind": { "$ref": "#/$defs/NetworkConfigurationEventKind" },
        "state": { "$ref": "#/$defs/NetworkConfigurationState" }
      }
    },
    "NetworkConfigurationSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_instance_id",
        "source_version",
        "adapter_version",
        "schema_version",
        "platform",
        "permission",
        "health",
        "sequence",
        "observed_at",
        "state"
      ],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "platform": { "$ref": "native-observation.schema.json#/$defs/PlatformFamily" },
        "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "state": { "$ref": "#/$defs/NetworkConfigurationState" }
      }
    },
    "NetworkConfigurationObservation": {
      "type": "object",
      "x-proctor-rules": ["gap_ends_immediately_before_sequence"],
      "additionalProperties": false,
      "required": ["source_instance_id", "sequence", "observed_at", "event"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "gap": { "$ref": "native-observation.schema.json#/$defs/SequenceGap" },
        "event": { "$ref": "#/$defs/NetworkConfigurationEvent" }
      }
    },
    "NetworkConfigurationDrain": {
      "type": "object",
      "x-proctor-rules": ["coherent_source_batch"],
      "additionalProperties": false,
      "required": ["source_instance_id", "health", "observations", "resets"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "observations": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/NetworkConfigurationObservation" }
        },
        "resets": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "native-observation.schema.json#/$defs/SourceReset" }
        },
        "terminal_error": { "$ref": "native-observation.schema.json#/$defs/SourceFailureCode" }
      }
    }
  }
}
