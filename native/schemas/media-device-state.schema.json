{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctor.invalid/native/media-device-state.schema.json",
  "title": "Proctor native media-device observation protocol",
  "$defs": {
    "MediaDeviceCoverage": {
      "type": "string",
      "enum": ["readiness_and_concurrent_use", "readiness_only", "not_collected", "unavailable"]
    },
    "MediaDeviceCertainty": { "type": "string", "enum": ["complete", "partial", "unknown"] },
    "MediaEndpointReadiness": { "type": "string", "enum": ["ready", "not_ready", "unknown"] },
    "MediaConcurrentUse": { "type": "string", "enum": ["inactive", "active", "unknown"] },
    "MediaEndpointState": {
      "type": "object",
      "x-proctor-rules": ["coherent_media_endpoint_state"],
      "additionalProperties": false,
      "required": [
        "coverage",
        "certainty",
        "permission",
        "readiness",
        "endpoint_count",
        "other_application_use"
      ],
      "properties": {
        "coverage": { "$ref": "#/$defs/MediaDeviceCoverage" },
        "certainty": { "$ref": "#/$defs/MediaDeviceCertainty" },
        "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" },
        "readiness": { "$ref": "#/$defs/MediaEndpointReadiness" },
        "endpoint_count": { "type": "integer", "minimum": 0, "maximum": 16, "x-rust-type": "u8" },
        "other_application_use": { "$ref": "#/$defs/MediaConcurrentUse" }
      }
    },
    "MediaDeviceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera", "microphone"],
      "properties": {
        "camera": { "$ref": "#/$defs/MediaEndpointState" },
        "microphone": { "$ref": "#/$defs/MediaEndpointState" }
      }
    },
    "MediaDeviceEventKind": { "type": "string", "enum": ["changed", "reconciled"] },
    "MediaDeviceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state"],
      "properties": {
        "kind": { "$ref": "#/$defs/MediaDeviceEventKind" },
        "state": { "$ref": "#/$defs/MediaDeviceState" }
      }
    },
    "MediaDeviceSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_instance_id",
        "source_version",
        "adapter_version",
        "platform",
        "permission",
        "health",
        "sequence",
        "observed_at",
        "state"
      ],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "$ref": "native-observation.schema.json#/$defs/PlatformFamily" },
        "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "state": { "$ref": "#/$defs/MediaDeviceState" }
      }
    },
    "MediaDeviceObservation": {
      "type": "object",
      "x-proctor-rules": ["gap_ends_immediately_before_sequence"],
      "additionalProperties": false,
      "required": ["source_instance_id", "sequence", "observed_at", "event"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "gap": { "$ref": "native-observation.schema.json#/$defs/SequenceGap" },
        "event": { "$ref": "#/$defs/MediaDeviceEvent" }
      }
    },
    "MediaDeviceDrain": {
      "type": "object",
      "x-proctor-rules": ["coherent_source_batch"],
      "additionalProperties": false,
      "required": ["source_instance_id", "health", "observations", "resets"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "observations": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/MediaDeviceObservation" }
        },
        "resets": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "native-observation.schema.json#/$defs/SourceReset" }
        },
        "terminal_error": { "$ref": "native-observation.schema.json#/$defs/SourceFailureCode" }
      }
    }
  }
}
