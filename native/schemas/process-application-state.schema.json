{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctor.invalid/native/process-application-state.schema.json",
  "title": "Proctor native process and application observation protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 }
  },
  "$defs": {
    "ProcessApplicationCoverage": {
      "type": "string",
      "enum": ["full_lifecycle", "snapshot_only", "unavailable"]
    },
    "ProcessApplicationCertainty": {
      "type": "string",
      "enum": ["complete", "partial", "unknown"]
    },
    "ProcessApplicationScope": {
      "type": "string",
      "enum": [
        "candidate_interactive_session",
        "other_interactive_session",
        "system_or_service",
        "unknown"
      ]
    },
    "ProcessExecutableIdentityStatus": {
      "type": "string",
      "enum": ["pending", "verified", "unsigned", "unavailable"]
    },
    "ProcessExecutableIdentity": {
      "type": "object",
      "x-proctor-rules": ["coherent_process_executable_identity"],
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/ProcessExecutableIdentityStatus" },
        "signer_chain_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "publisher_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "product_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "signing_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "team_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "designated_requirement": { "type": "string", "minLength": 1, "maxLength": 512 },
        "bundle_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "package_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "digest_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    },
    "ProcessApplicationProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_instance_id", "scope", "identity"],
      "properties": {
        "process_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "scope": { "$ref": "#/$defs/ProcessApplicationScope" },
        "identity": { "$ref": "#/$defs/ProcessExecutableIdentity" }
      }
    },
    "ProcessApplicationState": {
      "type": "object",
      "x-proctor-rules": ["coherent_process_application_state", "unique_process_instance_ids"],
      "additionalProperties": false,
      "required": ["coverage", "certainty", "processes"],
      "properties": {
        "coverage": { "$ref": "#/$defs/ProcessApplicationCoverage" },
        "certainty": { "$ref": "#/$defs/ProcessApplicationCertainty" },
        "processes": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/ProcessApplicationProcess" }
        }
      }
    },
    "ProcessApplicationEventKind": {
      "type": "string",
      "enum": ["started", "identity_changed", "exited", "reconciled"]
    },
    "ProcessApplicationEvent": {
      "type": "object",
      "x-proctor-rules": ["coherent_process_application_event"],
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/ProcessApplicationEventKind" },
        "process_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "process": { "$ref": "#/$defs/ProcessApplicationProcess" },
        "state": { "$ref": "#/$defs/ProcessApplicationState" }
      }
    },
    "ProcessApplicationSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_instance_id",
        "source_version",
        "adapter_version",
        "schema_version",
        "platform",
        "permission",
        "health",
        "sequence",
        "observed_at",
        "state"
      ],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "platform": { "$ref": "native-observation.schema.json#/$defs/PlatformFamily" },
        "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "state": { "$ref": "#/$defs/ProcessApplicationState" }
      }
    },
    "ProcessApplicationObservation": {
      "type": "object",
      "x-proctor-rules": ["gap_ends_immediately_before_sequence"],
      "additionalProperties": false,
      "required": ["source_instance_id", "sequence", "observed_at", "event"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "gap": { "$ref": "native-observation.schema.json#/$defs/SequenceGap" },
        "event": { "$ref": "#/$defs/ProcessApplicationEvent" }
      }
    },
    "ProcessApplicationDrain": {
      "type": "object",
      "x-proctor-rules": ["coherent_source_batch"],
      "additionalProperties": false,
      "required": ["source_instance_id", "health", "observations", "resets"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "observations": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/ProcessApplicationObservation" }
        },
        "resets": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "native-observation.schema.json#/$defs/SourceReset" }
        },
        "terminal_error": { "$ref": "native-observation.schema.json#/$defs/SourceFailureCode" }
      }
    }
  }
}
