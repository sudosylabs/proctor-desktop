{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctor.invalid/native/native-helper.schema.json",
  "title": "Proctor privileged native-helper protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 }
  },
  "$defs": {
    "HelperKind": {
      "type": "string",
      "enum": ["windows_security_service", "macos_endpoint_security_helper"]
    },
    "HelperSourceKind": {
      "type": "string",
      "enum": ["process_application", "interactive_session"]
    },
    "HelperEventClass": {
      "type": "string",
      "enum": ["process_lifecycle", "process_identity", "interactive_session_lifecycle"]
    },
    "HelperHandshake": {
      "type": "object",
      "x-proctor-rules": ["valid_helper_channel_nonce", "unique_helper_capabilities"],
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "channel_nonce",
        "helper_kind",
        "helper_build_id",
        "capabilities"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "channel_nonce": { "type": "string", "minLength": 64, "maxLength": 64 },
        "helper_kind": { "$ref": "#/$defs/HelperKind" },
        "helper_build_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "capabilities": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/HelperSourceKind" }
        }
      }
    },
    "HelperSourceOpen": {
      "type": "object",
      "x-proctor-rules": ["valid_helper_channel_nonce", "coherent_helper_source_open"],
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "channel_nonce",
        "helper_source_instance_id",
        "source_kind",
        "schema_version",
        "queue_capacity",
        "event_classes"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "channel_nonce": { "type": "string", "minLength": 64, "maxLength": 64 },
        "helper_source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_kind": { "$ref": "#/$defs/HelperSourceKind" },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "queue_capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1024,
          "x-rust-type": "u16"
        },
        "event_classes": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/HelperEventClass" }
        }
      }
    },
    "HelperSourceClose": {
      "type": "object",
      "x-proctor-rules": ["valid_helper_channel_nonce"],
      "additionalProperties": false,
      "required": ["protocol_version", "channel_nonce", "helper_source_instance_id"],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "channel_nonce": { "type": "string", "minLength": 64, "maxLength": 64 },
        "helper_source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 }
      }
    },
    "HelperSourceSnapshot": {
      "type": "object",
      "x-proctor-rules": ["valid_helper_channel_nonce", "coherent_helper_source_snapshot"],
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "channel_nonce",
        "helper_source_instance_id",
        "source_kind",
        "schema_version",
        "last_sequence",
        "monotonic_time_ns"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "channel_nonce": { "type": "string", "minLength": 64, "maxLength": 64 },
        "helper_source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_kind": { "$ref": "#/$defs/HelperSourceKind" },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "monotonic_time_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "process_state": {
          "$ref": "process-application-state.schema.json#/$defs/ProcessApplicationState"
        },
        "interactive_session_state": {
          "$ref": "interactive-session-state.schema.json#/$defs/InteractiveSessionState"
        }
      }
    },
    "HelperFailureCode": {
      "type": "string",
      "enum": [
        "permission_lost",
        "native_event_loss",
        "queue_overflow",
        "inventory_overflow",
        "backend",
        "cleanup",
        "protocol"
      ]
    },
    "HelperSourceFailure": {
      "type": "object",
      "x-proctor-rules": ["valid_helper_channel_nonce", "coherent_helper_source_failure"],
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "channel_nonce",
        "helper_source_instance_id",
        "source_kind",
        "failure_code",
        "last_sequence",
        "monotonic_time_ns"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "channel_nonce": { "type": "string", "minLength": 64, "maxLength": 64 },
        "helper_source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_kind": { "$ref": "#/$defs/HelperSourceKind" },
        "failure_code": { "$ref": "#/$defs/HelperFailureCode" },
        "last_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "lost_event_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "monotonic_time_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        }
      }
    },
    "HelperObservation": {
      "type": "object",
      "x-proctor-rules": ["valid_helper_channel_nonce", "coherent_helper_observation"],
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "channel_nonce",
        "helper_source_instance_id",
        "source_kind",
        "sequence",
        "monotonic_time_ns"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 65535,
          "x-rust-type": "u16"
        },
        "channel_nonce": { "type": "string", "minLength": 64, "maxLength": 64 },
        "helper_source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_kind": { "$ref": "#/$defs/HelperSourceKind" },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "monotonic_time_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "process_event": {
          "$ref": "process-application-state.schema.json#/$defs/ProcessApplicationEvent"
        },
        "interactive_session_event": {
          "$ref": "interactive-session-state.schema.json#/$defs/InteractiveSessionEvent"
        }
      }
    },
    "HelperClientMessageKind": {
      "type": "string",
      "enum": ["open", "close"]
    },
    "HelperClientMessage": {
      "type": "object",
      "x-proctor-rules": ["coherent_helper_client_message"],
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/HelperClientMessageKind" },
        "open": { "$ref": "#/$defs/HelperSourceOpen" },
        "close": { "$ref": "#/$defs/HelperSourceClose" }
      }
    },
    "HelperServerMessageKind": {
      "type": "string",
      "enum": ["snapshot", "observation", "failure"]
    },
    "HelperServerMessage": {
      "type": "object",
      "x-proctor-rules": ["coherent_helper_server_message"],
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/HelperServerMessageKind" },
        "snapshot": { "$ref": "#/$defs/HelperSourceSnapshot" },
        "observation": { "$ref": "#/$defs/HelperObservation" },
        "failure": { "$ref": "#/$defs/HelperSourceFailure" }
      }
    }
  }
}
