{
  "registry_version": 1,
  "family_modes": {
    "process_application": ["disabled", "observe", "enforce"],
    "interactive_session": ["disabled", "observe", "enforce"],
    "clipboard": ["disabled", "observe", "enforce"],
    "printing": ["disabled", "observe", "enforce"],
    "removable_storage": ["disabled", "observe", "enforce"],
    "virtualization": ["disabled", "observe", "enforce"],
    "network_configuration": ["disabled", "observe", "enforce"],
    "camera": ["disabled", "observe", "enforce"],
    "microphone": ["disabled", "observe", "enforce"],
    "external_capture": ["disabled"]
  },
  "families": [
    {
      "id": "process_application",
      "source_id": "process-application",
      "fact_schema": "native/schemas/process-application-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/ProcessApplicationPolicy",
      "permissions": {
        "windows": [],
        "macos": ["full_disk_access", "endpoint_security"],
        "linux": []
      },
      "effects": ["candidate_interaction_gate"],
      "sub_capabilities": [
        { "id": "process_application_lifecycle", "claims": ["enforce", "observe"] }
      ]
    },
    {
      "id": "interactive_session",
      "source_id": "interactive-session",
      "fact_schema": "native/schemas/interactive-session-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/InteractiveSessionPolicy",
      "permissions": {
        "windows": [],
        "macos": ["full_disk_access", "endpoint_security"],
        "linux": []
      },
      "effects": ["candidate_interaction_gate"],
      "sub_capabilities": [{ "id": "single_interactive_session", "claims": ["enforce", "observe"] }]
    },
    {
      "id": "clipboard",
      "source_id": "clipboard",
      "fact_schema": "native/schemas/clipboard-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/ClipboardPolicy",
      "permissions": { "windows": [], "macos": [], "linux": [] },
      "effects": ["candidate_private_clipboard"],
      "sub_capabilities": [
        { "id": "candidate_private_clipboard", "claims": ["enforce"] },
        { "id": "os_clipboard_change", "claims": ["observe"] }
      ]
    },
    {
      "id": "printing",
      "source_id": "print-spooler",
      "fact_schema": "native/schemas/print-spooler-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/PrintingPolicy",
      "permissions": { "windows": [], "macos": [], "linux": [] },
      "effects": ["candidate_print_command_denial", "candidate_interaction_gate"],
      "sub_capabilities": [
        { "id": "candidate_print_commands", "claims": ["enforce"] },
        { "id": "monitored_spooler_job", "claims": ["enforce", "observe"] },
        { "id": "no_physical_printing", "claims": [] }
      ]
    },
    {
      "id": "removable_storage",
      "source_id": "removable-storage",
      "fact_schema": "native/schemas/removable-storage-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/RemovableStoragePolicy",
      "permissions": { "windows": [], "macos": [], "linux": [] },
      "effects": ["candidate_interaction_gate"],
      "sub_capabilities": [
        { "id": "removable_block_storage", "claims": ["enforce", "observe"] },
        { "id": "portable_mtp", "claims": ["enforce", "observe"] }
      ]
    },
    {
      "id": "virtualization",
      "source_id": "virtualization",
      "fact_schema": "native/schemas/virtualization-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/VirtualizationPolicy",
      "permissions": { "windows": [], "macos": [], "linux": [] },
      "effects": ["candidate_interaction_gate"],
      "sub_capabilities": [
        { "id": "recognized_guest", "claims": ["enforce", "observe"] },
        { "id": "certified_physical_environment", "claims": ["enforce", "observe"] }
      ]
    },
    {
      "id": "network_configuration",
      "source_id": "network-configuration",
      "fact_schema": "native/schemas/network-configuration-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/NetworkConfigurationPolicy",
      "permissions": { "windows": [], "macos": [], "linux": [] },
      "effects": ["candidate_interaction_gate"],
      "sub_capabilities": [
        { "id": "system_proxy_state", "claims": ["enforce", "observe"] },
        { "id": "os_managed_vpn_state", "claims": ["enforce", "observe"] },
        { "id": "tunnel_interface_state", "claims": ["enforce", "observe"] },
        { "id": "route_change", "claims": ["observe"] },
        { "id": "network_source_health", "claims": ["enforce", "observe"] }
      ]
    },
    {
      "id": "camera",
      "source_id": "media-device",
      "fact_schema": "native/schemas/media-device-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/MediaDevicePolicy",
      "permissions": { "windows": ["camera"], "macos": ["camera"], "linux": [] },
      "effects": ["candidate_interaction_gate"],
      "sub_capabilities": [
        { "id": "camera_ready", "claims": ["enforce", "observe"] },
        { "id": "camera_other_application_use", "claims": ["enforce", "observe"] }
      ]
    },
    {
      "id": "microphone",
      "source_id": "media-device",
      "fact_schema": "native/schemas/media-device-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/MediaDevicePolicy",
      "permissions": { "windows": ["microphone"], "macos": ["microphone"], "linux": [] },
      "effects": ["candidate_interaction_gate"],
      "sub_capabilities": [
        { "id": "microphone_ready", "claims": ["enforce", "observe"] },
        { "id": "microphone_other_stream_running", "claims": ["enforce", "observe"] }
      ]
    },
    {
      "id": "external_capture",
      "source_id": "capture-session",
      "fact_schema": "native/schemas/capture-session-state.schema.json",
      "configuration_schema": "native/schemas/native-capability-policy.schema.json#/$defs/ExternalCapturePolicy",
      "permissions": { "windows": [], "macos": [], "linux": [] },
      "effects": ["candidate_content_protection"],
      "sub_capabilities": [{ "id": "external_capture_detection", "claims": [] }]
    }
  ]
}
