{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctor.invalid/native/capture-session-state.schema.json",
  "title": "Proctor native capture and remote-session observation protocol",
  "$defs": {
    "CaptureSessionSupport": {
      "type": "string",
      "enum": ["supported", "unsupported"]
    },
    "CaptureSessionActivity": {
      "type": "string",
      "enum": ["active", "inactive", "unknown"]
    },
    "CaptureSessionCertainty": {
      "type": "string",
      "enum": ["complete", "partial", "unknown"]
    },
    "CaptureSessionSignal": {
      "type": "object",
      "x-proctor-rules": ["coherent_capture_session_signal"],
      "additionalProperties": false,
      "required": ["support", "activity", "certainty"],
      "properties": {
        "support": { "$ref": "#/$defs/CaptureSessionSupport" },
        "activity": { "$ref": "#/$defs/CaptureSessionActivity" },
        "certainty": { "$ref": "#/$defs/CaptureSessionCertainty" }
      }
    },
    "CaptureSessionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_capture", "native_remote_session"],
      "properties": {
        "screen_capture": { "$ref": "#/$defs/CaptureSessionSignal" },
        "native_remote_session": { "$ref": "#/$defs/CaptureSessionSignal" }
      }
    },
    "CaptureSessionSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_instance_id",
        "source_version",
        "adapter_version",
        "platform",
        "permission",
        "health",
        "sequence",
        "observed_at",
        "state"
      ],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "platform": { "$ref": "native-observation.schema.json#/$defs/PlatformFamily" },
        "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "state": { "$ref": "#/$defs/CaptureSessionState" }
      }
    },
    "CaptureSessionObservation": {
      "type": "object",
      "x-proctor-rules": ["gap_ends_immediately_before_sequence"],
      "additionalProperties": false,
      "required": ["source_instance_id", "sequence", "observed_at", "state"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "gap": { "$ref": "native-observation.schema.json#/$defs/SequenceGap" },
        "state": { "$ref": "#/$defs/CaptureSessionState" }
      }
    },
    "CaptureSessionDrain": {
      "type": "object",
      "x-proctor-rules": ["coherent_source_batch"],
      "additionalProperties": false,
      "required": ["source_instance_id", "health", "observations", "resets"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "observations": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/CaptureSessionObservation" }
        },
        "resets": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "native-observation.schema.json#/$defs/SourceReset" }
        },
        "terminal_error": { "$ref": "native-observation.schema.json#/$defs/SourceFailureCode" }
      }
    }
  }
}
