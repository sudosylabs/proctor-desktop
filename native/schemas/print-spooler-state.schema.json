{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://proctor.invalid/native/print-spooler-state.schema.json", "title": "Proctor native print-spooler observation protocol",
  "type": "object", "additionalProperties": false, "required": ["schema_version"], "properties": { "schema_version": { "const": 1 } },
  "$defs": {
    "PrintSpoolerCoverage": { "type": "string", "enum": ["monitored_scheduler", "snapshot_only", "unavailable"] },
    "PrintSpoolerCertainty": { "type": "string", "enum": ["complete", "partial", "unknown"] },
    "PrintSpoolerState": {
      "type": "object", "x-proctor-rules": ["coherent_print_spooler_state"], "additionalProperties": false,
      "required": ["coverage", "certainty", "candidate_job_count", "other_job_count", "unknown_job_count"],
      "properties": { "coverage": { "$ref": "#/$defs/PrintSpoolerCoverage" }, "certainty": { "$ref": "#/$defs/PrintSpoolerCertainty" }, "candidate_job_count": { "type": "integer", "minimum": 0, "maximum": 64, "x-rust-type": "u8" }, "other_job_count": { "type": "integer", "minimum": 0, "maximum": 64, "x-rust-type": "u8" }, "unknown_job_count": { "type": "integer", "minimum": 0, "maximum": 64, "x-rust-type": "u8" } }
    },
    "PrintSpoolerEventKind": { "type": "string", "enum": ["changed", "reconciled"] },
    "PrintSpoolerEvent": { "type": "object", "additionalProperties": false, "required": ["kind", "state"], "properties": { "kind": { "$ref": "#/$defs/PrintSpoolerEventKind" }, "state": { "$ref": "#/$defs/PrintSpoolerState" } } },
    "PrintSpoolerSourceSnapshot": { "type": "object", "additionalProperties": false, "required": ["source_instance_id", "source_version", "adapter_version", "schema_version", "platform", "permission", "health", "sequence", "observed_at", "state"], "properties": { "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 }, "source_version": { "type": "string", "minLength": 1, "maxLength": 32 }, "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 }, "schema_version": { "type": "integer", "const": 1, "minimum": 1, "maximum": 65535, "x-rust-type": "u16" }, "platform": { "$ref": "native-observation.schema.json#/$defs/PlatformFamily" }, "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" }, "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" }, "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "x-rust-type": "u64" }, "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" }, "state": { "$ref": "#/$defs/PrintSpoolerState" } } },
    "PrintSpoolerObservation": { "type": "object", "x-proctor-rules": ["gap_ends_immediately_before_sequence"], "additionalProperties": false, "required": ["source_instance_id", "sequence", "observed_at", "event"], "properties": { "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 }, "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "x-rust-type": "u64" }, "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" }, "gap": { "$ref": "native-observation.schema.json#/$defs/SequenceGap" }, "event": { "$ref": "#/$defs/PrintSpoolerEvent" } } },
    "PrintSpoolerDrain": { "type": "object", "x-proctor-rules": ["coherent_source_batch"], "additionalProperties": false, "required": ["source_instance_id", "health", "observations", "resets"], "properties": { "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 }, "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" }, "observations": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/PrintSpoolerObservation" } }, "resets": { "type": "array", "maxItems": 1024, "items": { "$ref": "native-observation.schema.json#/$defs/SourceReset" } }, "terminal_error": { "$ref": "native-observation.schema.json#/$defs/SourceFailureCode" } } }
  }
}
