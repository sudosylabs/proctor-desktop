{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctor.invalid/native/display-topology.schema.json",
  "title": "Proctor native display-topology protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 }
  },
  "$defs": {
    "TopologyCertainty": {
      "type": "string",
      "enum": ["complete", "partial", "unknown"]
    },
    "DisplayTargetKind": {
      "type": "string",
      "enum": ["physical", "virtual", "remote", "specialized", "unknown"]
    },
    "DisplayPrimaryState": {
      "type": "string",
      "enum": ["primary", "not_primary", "unknown"]
    },
    "DisplayPowerState": {
      "type": "string",
      "enum": ["awake", "asleep", "unknown"]
    },
    "DisplayTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "active", "primary_state", "builtin", "power_state", "kind", "pixel_width", "pixel_height"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "active": { "type": "boolean" },
        "primary_state": { "$ref": "#/$defs/DisplayPrimaryState" },
        "builtin": { "type": "boolean" },
        "power_state": { "$ref": "#/$defs/DisplayPowerState" },
        "kind": { "$ref": "#/$defs/DisplayTargetKind" },
        "mirror_primary_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pixel_width": { "type": "integer", "minimum": 0, "maximum": 262144, "x-rust-type": "u32" },
        "pixel_height": { "type": "integer", "minimum": 0, "maximum": 262144, "x-rust-type": "u32" }
      }
    },
    "DisplayTopologySnapshot": {
      "type": "object",
      "x-proctor-rules": ["unique_target_ids", "valid_mirror_references"],
      "additionalProperties": false,
      "required": ["certainty", "targets"],
      "properties": {
        "certainty": { "$ref": "#/$defs/TopologyCertainty" },
        "targets": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/DisplayTarget" }
        }
      }
    },
    "DisplayTopologySourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_instance_id", "source_version", "adapter_version", "schema_version", "platform", "permission", "health", "sequence", "observed_at", "topology"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "schema_version": { "type": "integer", "const": 1, "minimum": 1, "maximum": 65535, "x-rust-type": "u16" },
        "platform": { "$ref": "native-observation.schema.json#/$defs/PlatformFamily" },
        "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "x-rust-type": "u64" },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "topology": { "$ref": "#/$defs/DisplayTopologySnapshot" }
      }
    },
    "DisplayTopologyObservation": {
      "type": "object",
      "x-proctor-rules": ["gap_ends_immediately_before_sequence"],
      "additionalProperties": false,
      "required": ["source_instance_id", "sequence", "observed_at", "topology"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "x-rust-type": "u64" },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "gap": { "$ref": "native-observation.schema.json#/$defs/SequenceGap" },
        "topology": { "$ref": "#/$defs/DisplayTopologySnapshot" }
      }
    },
    "DisplayTopologyDrain": {
      "type": "object",
      "x-proctor-rules": ["coherent_source_batch"],
      "additionalProperties": false,
      "required": ["source_instance_id", "health", "observations", "resets"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "observations": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/DisplayTopologyObservation" }
        },
        "resets": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "native-observation.schema.json#/$defs/SourceReset" }
        },
        "terminal_error": { "$ref": "native-observation.schema.json#/$defs/SourceFailureCode" }
      }
    }
  }
}
