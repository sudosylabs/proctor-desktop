{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctor.invalid/native/removable-storage-state.schema.json",
  "title": "Proctor native removable-storage observation protocol",
  "$defs": {
    "RemovableStorageCoverage": {
      "type": "string",
      "enum": ["block_and_portable", "block_only", "snapshot_only", "unavailable"]
    },
    "RemovableStorageCertainty": { "type": "string", "enum": ["complete", "partial", "unknown"] },
    "RemovableStorageFunctionKind": { "type": "string", "enum": ["block_storage", "portable_mtp"] },
    "RemovableStorageTransport": {
      "type": "string",
      "enum": ["usb", "thunderbolt", "sd", "portable", "other", "unknown"]
    },
    "RemovableStorageWritability": {
      "type": "string",
      "enum": ["writable", "read_only", "unknown"]
    },
    "RemovableStorageAttachment": {
      "type": "string",
      "enum": ["attached_unmounted", "mounted", "unknown"]
    },
    "RemovableStorageFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function_instance_id", "kind", "transport", "writability", "attachment"],
      "properties": {
        "function_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "kind": { "$ref": "#/$defs/RemovableStorageFunctionKind" },
        "transport": { "$ref": "#/$defs/RemovableStorageTransport" },
        "writability": { "$ref": "#/$defs/RemovableStorageWritability" },
        "attachment": { "$ref": "#/$defs/RemovableStorageAttachment" }
      }
    },
    "RemovableStorageState": {
      "type": "object",
      "x-proctor-rules": [
        "coherent_removable_storage_state",
        "unique_removable_storage_function_ids"
      ],
      "additionalProperties": false,
      "required": ["coverage", "certainty", "attached_functions"],
      "properties": {
        "coverage": { "$ref": "#/$defs/RemovableStorageCoverage" },
        "certainty": { "$ref": "#/$defs/RemovableStorageCertainty" },
        "attached_functions": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/RemovableStorageFunction" }
        }
      }
    },
    "RemovableStorageEventKind": { "type": "string", "enum": ["changed", "reconciled"] },
    "RemovableStorageEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state"],
      "properties": {
        "kind": { "$ref": "#/$defs/RemovableStorageEventKind" },
        "state": { "$ref": "#/$defs/RemovableStorageState" }
      }
    },
    "RemovableStorageSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_instance_id",
        "source_version",
        "adapter_version",
        "platform",
        "permission",
        "health",
        "sequence",
        "observed_at",
        "state"
      ],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "$ref": "native-observation.schema.json#/$defs/PlatformFamily" },
        "permission": { "$ref": "native-observation.schema.json#/$defs/PermissionState" },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "state": { "$ref": "#/$defs/RemovableStorageState" }
      }
    },
    "RemovableStorageObservation": {
      "type": "object",
      "x-proctor-rules": ["gap_ends_immediately_before_sequence"],
      "additionalProperties": false,
      "required": ["source_instance_id", "sequence", "observed_at", "event"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "observed_at": { "$ref": "native-observation.schema.json#/$defs/SourceTimestamp" },
        "gap": { "$ref": "native-observation.schema.json#/$defs/SequenceGap" },
        "event": { "$ref": "#/$defs/RemovableStorageEvent" }
      }
    },
    "RemovableStorageDrain": {
      "type": "object",
      "x-proctor-rules": ["coherent_source_batch"],
      "additionalProperties": false,
      "required": ["source_instance_id", "health", "observations", "resets"],
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 16, "maxLength": 64 },
        "health": { "$ref": "native-observation.schema.json#/$defs/SourceHealth" },
        "observations": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/RemovableStorageObservation" }
        },
        "resets": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "native-observation.schema.json#/$defs/SourceReset" }
        },
        "terminal_error": { "$ref": "native-observation.schema.json#/$defs/SourceFailureCode" }
      }
    }
  }
}
